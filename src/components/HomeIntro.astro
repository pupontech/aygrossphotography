---
interface Props {
  heading?: string;
  paragraphs?: string[];
  ctaLabel?: string;
  ctaDestination?: string;
}

const {
  heading = 'Natural, candid photography for families and simchas.',
  paragraphs = [
    'Based in Jerusalem and serving clients across Israel, I specialize in relaxed family portraits and authentic event photography.',
    'My focus is on patience, natural light, and keeping sessions comfortable—so your images reflect genuine warmth rather than stiff poses.'
  ],
  ctaLabel = 'Explore All Portfolios',
  ctaDestination = '/portraits'
} = Astro.props;
---

<section class="home-intro" aria-label="Introduction & Approach">
  <div class="intro-inner">
    <div class="section-divider" aria-hidden="true"></div>
    <span class="intro-eyebrow">How I Work</span>
    <h2 class="intro-heading">{heading}</h2>
    <div class="intro-body">
      {paragraphs.map((p) => (
        <p class="intro-paragraph">{p}</p>
      ))}
    </div>
    {ctaLabel && (
      <div class="intro-cta">
        <a href={ctaDestination} class="intro-link">
          <span>{ctaLabel}</span>
          <span class="intro-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </div>
</section>

<style>
  .home-intro {
    width: 100%;
    margin: var(--spacing-3xl) 0;
    padding: var(--spacing-3xl) 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  /* Centered Text Layout */
  .intro-inner {
    max-width: 740px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-divider {
    margin: 0 auto 2rem;
  }

  .intro-eyebrow {
    display: block;
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--text-muted);
    font-weight: 500;
    margin-bottom: 1.25rem;
    text-align: center;
  }

  .intro-heading {
    font-family: var(--font-brand);
    font-size: clamp(1.65rem, 2.8vw, 2.35rem);
    line-height: 1.35;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    margin-bottom: 1.85rem;
    text-align: center;
    max-width: 680px;
    font-weight: 300;
  }

  .intro-body {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2.25rem;
    text-align: center;
    max-width: 620px;
  }

  .intro-paragraph {
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--text-secondary);
    text-align: center;
  }

  .intro-cta {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .intro-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-primary);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 3px;
    transition: color var(--transition-smooth), border-color var(--transition-smooth);
  }

  .intro-link:hover {
    color: var(--accent-text);
    border-color: var(--accent-text);
  }

  .intro-link:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 3px;
    border-radius: var(--radius-sm);
  }
</style>
