---
import type { ImageSource } from '../lib/types';
import { getImageUrl, buildSrcSet } from '../lib/image';

interface Props {
  image: ImageSource;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  aspectRatio?: number;
  width?: number;
  height?: number;
}

const {
  image,
  alt,
  widths = [480, 768, 1024, 1440, 1920],
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  class: className = '',
  aspectRatio,
  width: customWidth,
  height: customHeight
} = Astro.props;

if (!image) {
  return null;
}

const defaultSrc = getImageUrl(image);
const srcSet = buildSrcSet(image, widths);

// Only set explicit dimensions when provided — otherwise let the image's
// natural aspect ratio drive the layout for a true masonry / flow feel.
const hasExplicitDimensions = customWidth || customHeight || aspectRatio;
const computedWidth = customWidth || (aspectRatio ? 1200 : undefined);
const computedHeight = customHeight || (aspectRatio ? Math.round(1200 / aspectRatio) : undefined);
const styleAttr = aspectRatio
  ? `aspect-ratio: ${aspectRatio};`
  : hasExplicitDimensions && computedWidth && computedHeight
    ? `aspect-ratio: ${computedWidth} / ${computedHeight};`
    : '';
---

<img
  src={defaultSrc}
  srcset={srcSet}
  sizes={sizes}
  alt={alt}
  width={computedWidth}
  height={computedHeight}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  style={styleAttr || undefined}
  class={`photo-image ${className}`.trim()}
/>

<style>
  .photo-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background-color: var(--bg-secondary);
    transition: opacity var(--transition-smooth);
  }
</style>
