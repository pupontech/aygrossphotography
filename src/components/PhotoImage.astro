---
import type { ImageSource } from '../lib/types';
import { getImageUrl, buildSrcSet } from '../lib/image';

interface Props {
  image: ImageSource;
  alt: string;
  widths?: number[];
  sizes?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  aspectRatio?: number;
  width?: number;
  height?: number;
}

const {
  image,
  alt,
  widths = [480, 768, 1024, 1440, 1920],
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
  loading = 'lazy',
  decoding = 'async',
  fetchpriority,
  class: className = '',
  aspectRatio,
  width: customWidth,
  height: customHeight
} = Astro.props;

if (!image) {
  return null;
}

const defaultSrc = getImageUrl(image);
const srcSet = buildSrcSet(image, widths);
const originalWidth = customWidth || 1200;
const originalHeight = customHeight || (aspectRatio ? Math.round(originalWidth / aspectRatio) : 800);
---

<img
  src={defaultSrc}
  srcset={srcSet}
  sizes={sizes}
  alt={alt}
  width={originalWidth}
  height={originalHeight}
  loading={loading}
  decoding={decoding}
  fetchpriority={fetchpriority}
  style={`aspect-ratio: ${aspectRatio ? aspectRatio : `${originalWidth} / ${originalHeight}`};`}
  class={`photo-image ${className}`.trim()}
/>

<style>
  .photo-image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    background-color: var(--bg-secondary);
    transition: opacity var(--transition-smooth);
  }
</style>
