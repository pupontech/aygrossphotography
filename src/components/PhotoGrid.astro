---
import type { SanityPhoto } from '../lib/sanity/types';
import SanityImage from './SanityImage.astro';
import { getLightboxImageUrl } from '../lib/sanity/image';

interface Props {
  photos: SanityPhoto[];
  galleryTitle?: string;
  columns?: number;
}

const { photos = [], galleryTitle = 'Gallery' } = Astro.props;
---

<div class="photo-grid-container" data-gallery-title={galleryTitle}>
  <div class="photo-masonry">
    {photos.map((photo, index) => {
      const largeSrc = getLightboxImageUrl(photo.image, 2200);
      const altText = photo.alt || photo.internalTitle || `Photograph ${index + 1}`;
      const captionText = photo.caption || '';

      return (
        <button
          type="button"
          class="photo-card"
          data-photo-index={index}
          data-large-src={largeSrc}
          data-alt={altText}
          data-caption={captionText}
          aria-label={`View photo ${index + 1}: ${altText}`}
        >
          <div class="photo-wrapper">
            <SanityImage
              image={photo.image}
              alt={altText}
              loading={index < 3 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
              sizes="(max-width: 640px) 100vw, (max-width: 1023px) 50vw, (max-width: 1440px) 33vw, 25vw"
              class="photo-img"
            />
          </div>
        </button>
      );
    })}
  </div>
</div>

<style>
  .photo-grid-container {
    width: 100%;
  }

  /* Responsive CSS Column Masonry to preserve natural photo aspect ratios */
  .photo-masonry {
    column-count: 1;
    column-gap: 1.25rem;
  }

  @media (min-width: 640px) {
    .photo-masonry {
      column-count: 2;
      column-gap: 1.5rem;
    }
  }

  @media (min-width: 1100px) {
    .photo-masonry {
      column-count: 3;
      column-gap: 1.75rem;
    }
  }

  .photo-card {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    width: 100%;
    padding: 0;
    border: none;
    background: none;
    text-align: left;
    cursor: pointer;
    border-radius: 2px;
    overflow: hidden;
    position: relative;
    display: block;
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .photo-wrapper {
    position: relative;
    overflow: hidden;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    transition: border-color var(--transition-smooth);
  }

  .photo-card:hover .photo-wrapper {
    border-color: var(--border-strong);
  }

  .photo-card:hover {
    transform: translateY(-2px);
  }

  .photo-card:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
  }

  :global(.photo-img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 400ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .photo-card:hover :global(.photo-img) {
    transform: scale(1.015);
  }
</style>
