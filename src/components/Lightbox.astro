---
// Vanilla TypeScript / JS accessible lightbox component with zero React dependencies
---

<div
  id="lightbox-modal"
  class="lightbox-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Photography viewer"
  aria-hidden="true"
  tabindex="-1"
>
  <!-- Background backdrop -->
  <div class="lightbox-backdrop" id="lightbox-backdrop"></div>

  <!-- Main viewer content container -->
  <div class="lightbox-container" id="lightbox-container">
    <!-- Top toolbar: counter & close button -->
    <div class="lightbox-toolbar">
      <span class="lightbox-counter" id="lightbox-counter" aria-live="polite"></span>
      <button
        type="button"
        class="lightbox-btn lightbox-close-btn"
        id="lightbox-close"
        aria-label="Close photography viewer"
        title="Close (Escape)"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Central stage with previous / next buttons and image wrapper -->
    <div class="lightbox-stage">
      <button
        type="button"
        class="lightbox-btn lightbox-nav-btn lightbox-prev-btn"
        id="lightbox-prev"
        aria-label="Previous photograph"
        title="Previous (Left arrow)"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="lightbox-figure-wrapper" id="lightbox-figure-wrapper">
        <!-- Loading spinner -->
        <div class="lightbox-loader" id="lightbox-loader">
          <span class="loader-dot"></span>
          <span class="loader-dot"></span>
          <span class="loader-dot"></span>
        </div>
        <img
          id="lightbox-image"
          class="lightbox-image"
          src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E"
          alt=""
          decoding="async"
        />
        <div id="lightbox-caption" class="lightbox-caption" aria-live="polite"></div>
      </div>

      <button
        type="button"
        class="lightbox-btn lightbox-nav-btn lightbox-next-btn"
        id="lightbox-next"
        aria-label="Next photograph"
        title="Next (Right arrow)"
      >
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>
  </div>
</div>

<style>
  .lightbox-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 300ms cubic-bezier(0.16, 1, 0.3, 1), visibility 300ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .lightbox-overlay[aria-hidden="false"] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .lightbox-backdrop {
    position: absolute;
    inset: 0;
    background-color: var(--bg-lightbox);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .lightbox-container {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    z-index: 2;
    padding: 1rem 1.5rem;
  }

  .lightbox-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 48px;
    color: #fcfbf9;
    flex-shrink: 0;
  }

  .lightbox-counter {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    color: #a3a19b;
    font-weight: 400;
    font-variant-numeric: tabular-nums;
  }

  .lightbox-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    color: #fcfbf9;
    background-color: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    cursor: pointer;
    transition: background-color var(--transition-smooth), transform var(--transition-smooth), border-color var(--transition-smooth);
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .lightbox-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
    border-color: rgba(255, 255, 255, 0.25);
    transform: scale(1.05);
  }

  .lightbox-btn:active {
    transform: scale(0.95);
  }

  .lightbox-btn:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .lightbox-stage {
    position: relative;
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 0;
    gap: 1rem;
  }

  .lightbox-figure-wrapper {
    position: relative;
    flex: 1;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 0;
    overflow: hidden;
  }

  /* Loading spinner */
  .lightbox-loader {
    position: absolute;
    display: flex;
    gap: 6px;
    opacity: 0;
    transition: opacity 300ms ease;
  }

  .lightbox-loader.visible {
    opacity: 1;
  }

  .loader-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    animation: loaderPulse 1.2s infinite ease-in-out;
  }

  .loader-dot:nth-child(2) { animation-delay: 0.15s; }
  .loader-dot:nth-child(3) { animation-delay: 0.3s; }

  @keyframes loaderPulse {
    0%, 80%, 100% {
      opacity: 0.3;
      transform: scale(0.8);
    }
    40% {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Image transitions */
  .lightbox-image {
    max-width: 100%;
    max-height: calc(100vh - 140px);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--radius-sm);
    box-shadow: 0 16px 64px rgba(0, 0, 0, 0.5);
    opacity: 0;
    transform: scale(0.97);
    transition: opacity 350ms ease-out, transform 350ms ease-out;
  }

  .lightbox-image.loaded {
    opacity: 1;
    transform: scale(1);
  }

  .lightbox-caption {
    margin-top: 0.85rem;
    font-size: 0.875rem;
    color: #c8c5bc;
    text-align: center;
    max-width: 800px;
    letter-spacing: 0.02em;
    min-height: 1.25rem;
    font-family: var(--font-serif);
    font-style: italic;
    opacity: 0;
    transition: opacity 300ms ease 200ms;
  }

  .lightbox-image.loaded ~ .lightbox-caption {
    opacity: 1;
  }

  .lightbox-caption:empty {
    display: none;
  }

  @media (max-width: 768px) {
    .lightbox-container {
      padding: 0.75rem;
    }

    .lightbox-nav-btn {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      z-index: 10;
      background-color: rgba(0, 0, 0, 0.45);
      border-color: rgba(255, 255, 255, 0.08);
    }

    .lightbox-prev-btn {
      left: 0.5rem;
    }

    .lightbox-next-btn {
      right: 0.5rem;
    }
  }
</style>

<script>
  // Vanilla JS controller for the accessible lightbox
  class LightboxController {
    private modal: HTMLElement | null = null;
    private backdrop: HTMLElement | null = null;
    private imageEl: HTMLImageElement | null = null;
    private captionEl: HTMLElement | null = null;
    private counterEl: HTMLElement | null = null;
    private closeBtn: HTMLElement | null = null;
    private prevBtn: HTMLElement | null = null;
    private nextBtn: HTMLElement | null = null;
    private loaderEl: HTMLElement | null = null;

    private photos: Array<{
      largeSrc: string;
      alt: string;
      caption: string;
    }> = [];

    private currentIndex: number = 0;
    private lastFocusedElement: HTMLElement | null = null;
    private loadRequestId: number = 0;

    // Touch swipe handling
    private touchStartX: number = 0;
    private touchStartY: number = 0;

    constructor() {
      this.initElements();
      this.bindTriggers();
      this.bindEvents();
    }

    private initElements() {
      this.modal = document.getElementById('lightbox-modal');
      this.backdrop = document.getElementById('lightbox-backdrop');
      this.imageEl = document.getElementById('lightbox-image') as HTMLImageElement;
      this.captionEl = document.getElementById('lightbox-caption');
      this.counterEl = document.getElementById('lightbox-counter');
      this.closeBtn = document.getElementById('lightbox-close');
      this.prevBtn = document.getElementById('lightbox-prev');
      this.nextBtn = document.getElementById('lightbox-next');
      this.loaderEl = document.getElementById('lightbox-loader');
    }

    private bindTriggers() {
      const cards = document.querySelectorAll<HTMLButtonElement>('.photo-card');
      this.photos = [];

      cards.forEach((card, idx) => {
        const largeSrc = card.getAttribute('data-large-src') || '';
        const alt = card.getAttribute('data-alt') || '';
        const caption = card.getAttribute('data-caption') || '';

        this.photos.push({ largeSrc, alt, caption });

        card.addEventListener('click', (e) => {
          e.preventDefault();
          this.open(idx, card);
        });
      });
    }

    private bindEvents() {
      if (this.closeBtn) {
        this.closeBtn.addEventListener('click', () => this.close());
      }
      if (this.backdrop) {
        this.backdrop.addEventListener('click', () => this.close());
      }
      if (this.prevBtn) {
        this.prevBtn.addEventListener('click', () => this.prev());
      }
      if (this.nextBtn) {
        this.nextBtn.addEventListener('click', () => this.next());
      }

      // Keyboard navigation
      document.addEventListener('keydown', (e) => {
        if (!this.isOpen()) return;

        if (e.key === 'Escape') {
          e.preventDefault();
          this.close();
        } else if (e.key === 'ArrowLeft') {
          e.preventDefault();
          this.prev();
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          this.next();
        } else if (e.key === 'Tab') {
          this.handleFocusTrap(e);
        }
      });

      // Touch swipe gestures
      if (this.modal) {
        this.modal.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].clientX;
          this.touchStartY = e.changedTouches[0].clientY;
        }, { passive: true });

        this.modal.addEventListener('touchend', (e) => {
          const deltaX = e.changedTouches[0].clientX - this.touchStartX;
          const deltaY = e.changedTouches[0].clientY - this.touchStartY;

          // Horizontal swipe with minimal vertical drift
          if (Math.abs(deltaX) > 45 && Math.abs(deltaY) < 70) {
            if (deltaX > 0) {
              this.prev();
            } else {
              this.next();
            }
          }
        }, { passive: true });
      }
    }

    private isOpen(): boolean {
      return this.modal?.getAttribute('aria-hidden') === 'false';
    }

    public open(index: number, triggerElement?: HTMLElement) {
      if (!this.modal || this.photos.length === 0) return;

      this.lastFocusedElement = triggerElement || (document.activeElement as HTMLElement);
      this.currentIndex = index;
      this.updateContent();

      this.modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';

      // Focus close button initially
      setTimeout(() => {
        this.closeBtn?.focus();
      }, 50);
    }

    public close() {
      if (!this.modal) return;

      this.modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';

      if (this.imageEl) {
        this.imageEl.classList.remove('loaded');
        this.imageEl.src = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg'/%3E";
      }

      this.loaderEl?.classList.remove('visible');

      // Restore focus to original trigger
      if (this.lastFocusedElement) {
        this.lastFocusedElement.focus();
      }
    }

    public prev() {
      if (this.photos.length === 0) return;
      this.currentIndex = (this.currentIndex - 1 + this.photos.length) % this.photos.length;
      this.updateContent();
    }

    public next() {
      if (this.photos.length === 0) return;
      this.currentIndex = (this.currentIndex + 1) % this.photos.length;
      this.updateContent();
    }

    private updateContent() {
      const item = this.photos[this.currentIndex];
      if (!item || !this.imageEl) return;

      const currentReq = ++this.loadRequestId;

      // Show loader, hide image
      this.imageEl.classList.remove('loaded');
      this.loaderEl?.classList.add('visible');

      const tempImg = new Image();
      tempImg.onload = () => {
        if (this.loadRequestId !== currentReq) return;
        if (this.imageEl) {
          this.imageEl.src = item.largeSrc;
          this.imageEl.alt = item.alt;
          requestAnimationFrame(() => {
            this.loaderEl?.classList.remove('visible');
            this.imageEl?.classList.add('loaded');
          });
        }
      };
      tempImg.onerror = () => {
        if (this.loadRequestId !== currentReq) return;
        this.loaderEl?.classList.remove('visible');
        if (this.captionEl) {
          this.captionEl.textContent = 'Photograph unavailable. Please check your connection.';
        }
      };
      tempImg.src = item.largeSrc;

      if (this.captionEl) {
        this.captionEl.textContent = item.caption;
      }

      if (this.counterEl) {
        this.counterEl.textContent = `${this.currentIndex + 1} / ${this.photos.length}`;
      }
    }

    private handleFocusTrap(e: KeyboardEvent) {
      if (!this.modal) return;

      const focusableSelectors = 'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])';
      const focusables = Array.from(this.modal.querySelectorAll<HTMLElement>(focusableSelectors))
        .filter((el) => !el.hasAttribute('disabled') && el.offsetParent !== null);

      if (focusables.length === 0) return;

      const firstElement = focusables[0];
      const lastElement = focusables[focusables.length - 1];

      if (e.shiftKey) {
        if (document.activeElement === firstElement) {
          e.preventDefault();
          lastElement.focus();
        }
      } else {
        if (document.activeElement === lastElement) {
          e.preventDefault();
          firstElement.focus();
        }
      }
    }
  }

  // Initialize lightbox on DOM ready with single-instance guard
  function initLightbox() {
    if ((window as any).__lightboxController) return;
    (window as any).__lightboxController = new LightboxController();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLightbox);
  } else {
    initLightbox();
  }
</script>
