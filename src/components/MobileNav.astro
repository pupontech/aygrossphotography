---
import type { SiteSettings } from '../lib/types';

interface Props {
  currentPath: string;
  settings?: SiteSettings | null;
}

const { settings } = Astro.props;

const navItems = [
  { label: 'Portraits', href: '/#portraits', target: 'portraits' },
  { label: 'Events', href: '/#events', target: 'events' },
  { label: 'About', href: '/#about', target: 'about' },
  { label: 'Pricing', href: '/#pricing', target: 'pricing' },
  { label: 'FAQ', href: '/#faq', target: 'faq' },
  { label: 'Contact', href: '/#contact', target: 'contact' },
];

const editingServicesUrl = settings?.editingServicesUrl || 'https://darkroomedits.com/';
const businessName = settings?.businessName || 'AY Gross Photography';
const phone = settings?.phone || '058-772-5628';
const phoneTel = phone.startsWith('+') ? phone.replace(/[^0-9+]/g, '') : `+972${phone.replace(/^0/, '').replace(/[^0-9]/g, '')}`;
const email = settings?.email || 'aygrossphotography@gmail.com';
const instagramUrl = settings?.socialLinks?.instagram || 'https://instagram.com/aygrossphotography';
const facebookUrl = settings?.socialLinks?.facebook || 'https://facebook.com/aygrossphotography';
---

<div class="mobile-nav-container">
  <!-- Fixed mobile top bar with frosted glass -->
  <header class="mobile-header">
    <a href="/#hero" class="mobile-brand" aria-label="AY Gross Photography - Home">
      <span class="mobile-brand-name">{businessName}</span>
    </a>

    <div class="mobile-actions">
      <!-- Theme toggle button -->
      <button
        type="button"
        class="mobile-theme-btn"
        id="theme-toggle-mobile"
        aria-label="Switch to light mode"
        aria-pressed="true"
        title="Switch to light mode"
      >
        <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="5"></circle>
          <line x1="12" y1="1" x2="12" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="23"></line>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
          <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
          <line x1="1" y1="12" x2="3" y2="12"></line>
          <line x1="21" y1="12" x2="23" y2="12"></line>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
          <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
        </svg>
        <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <!-- Hamburger toggle button -->
      <button
        type="button"
        class="hamburger-btn"
        id="mobile-menu-trigger"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </header>

  <!-- Mobile navigation drawer backdrop & overlay -->
  <div class="mobile-drawer-overlay" id="mobile-drawer-overlay" aria-hidden="true">
    <div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop"></div>
    <div class="mobile-drawer" id="mobile-drawer" role="dialog" aria-modal="true" aria-label="Site Navigation">
      <div class="drawer-header">
        <button
          type="button"
          class="drawer-close-btn"
          id="mobile-menu-close"
          aria-label="Close navigation menu"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav class="drawer-nav">
        <ul class="drawer-list" role="list">
          {navItems.map((item, index) => (
            <li class="drawer-item">
              <a
                href={item.href}
                data-nav-target={item.target}
                class={`drawer-link ${index === 0 ? 'active' : ''}`}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li class="drawer-item">
            <a
              href={editingServicesUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="drawer-link external-drawer-link"
            >
              Editing Services ↗
            </a>
          </li>
        </ul>
      </nav>

      <div class="drawer-footer">
        <div class="drawer-socials" aria-label="Social Links">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="drawer-social-link"
            aria-label="Instagram Profile"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
            <span>Instagram</span>
          </a>
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="drawer-social-link"
            aria-label="Facebook Profile"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
            <span>Facebook</span>
          </a>
        </div>
        <a href={`tel:${phoneTel}`} class="drawer-contact-link">{phone}</a>
        <a href={`mailto:${email}`} class="drawer-contact-link">{email}</a>
      </div>
    </div>
  </div>
</div>

<style>
  .mobile-nav-container {
    display: block;
  }

  @media (min-width: 1024px) {
    .mobile-nav-container {
      display: none;
    }
  }

  /* Frosted glass header */
  .mobile-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--header-height-mobile);
    background-color: color-mix(in srgb, var(--bg-sidebar) 80%, transparent);
    backdrop-filter: saturate(180%) blur(16px);
    -webkit-backdrop-filter: saturate(180%) blur(16px);
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    z-index: 1000;
    transition: background-color var(--transition-smooth), border-color var(--transition-smooth);
  }

  .mobile-brand {
    text-decoration: none;
  }

  .mobile-brand-name {
    font-family: var(--font-brand);
    font-size: 1.15rem;
    color: var(--text-primary);
  }

  .mobile-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .mobile-theme-btn,
  .hamburger-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--text-primary);
    border-radius: var(--radius-md);
    transition: background-color var(--transition-smooth);
  }

  .mobile-theme-btn:hover,
  .hamburger-btn:hover {
    background-color: var(--bg-hover);
  }

  /* Sun/moon icons in mobile */
  :global([data-theme="dark"]) .mobile-theme-btn .sun-icon { display: block; }
  :global([data-theme="dark"]) .mobile-theme-btn .moon-icon { display: none; }
  :global(:not([data-theme="dark"])) .mobile-theme-btn .sun-icon { display: none; }
  :global(:not([data-theme="dark"])) .mobile-theme-btn .moon-icon { display: block; }

  /* Overlay */
  .mobile-drawer-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    visibility: hidden;
    opacity: 0;
    transition: opacity 240ms ease, visibility 240ms ease;
  }

  .mobile-drawer-overlay[aria-hidden="false"] {
    visibility: visible;
    opacity: 1;
  }

  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  /* Drawer panel */
  .mobile-drawer {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(320px, 85vw);
    background-color: var(--bg-sidebar);
    border-left: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    padding: 1.5rem 1.5rem 2rem;
    transform: translateX(100%);
    transition: transform 300ms cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.15);
  }

  .mobile-drawer-overlay[aria-hidden="false"] .mobile-drawer {
    transform: translateX(0);
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .drawer-close-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    color: var(--text-primary);
    border-radius: var(--radius-sm);
    transition: background-color var(--transition-smooth);
  }

  .drawer-close-btn:hover {
    background-color: var(--bg-hover);
  }

  .drawer-nav {
    flex: 1;
    overflow-y: auto;
  }

  .drawer-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .drawer-link {
    display: block;
    padding: 0.75rem 0.85rem;
    font-size: 1.1rem;
    color: var(--text-secondary);
    font-family: var(--font-brand);
    border-radius: var(--radius-sm);
    transition: color var(--transition-smooth), background-color var(--transition-smooth);
    position: relative;
  }

  .drawer-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-hover);
  }

  .drawer-link.active {
    color: var(--text-primary);
    font-weight: 600;
    background-color: var(--accent-soft);
    border-left: 2px solid var(--accent);
  }

  .external-drawer-link {
    font-style: italic;
    color: var(--text-muted);
    margin-top: 0.5rem;
  }

  .drawer-footer {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .drawer-contact-link {
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color var(--transition-smooth);
  }

  .drawer-contact-link:hover {
    color: var(--accent-text);
  }

  .drawer-socials {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .drawer-social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    transition: color var(--transition-smooth);
  }

  .drawer-social-link:hover {
    color: var(--accent-text);
  }
</style>

<script>
  // Mobile drawer interactive logic with accessible focus trapping
  function initMobileNav() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const closeBtn = document.getElementById('mobile-menu-close');
    const overlay = document.getElementById('mobile-drawer-overlay');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    const drawer = document.getElementById('mobile-drawer');

    if (!trigger || !overlay) return;

    function openDrawer() {
      overlay?.setAttribute('aria-hidden', 'false');
      trigger?.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      setTimeout(() => closeBtn?.focus(), 50);
    }

    function closeDrawer() {
      overlay?.setAttribute('aria-hidden', 'true');
      trigger?.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      trigger?.focus();
    }

    trigger.addEventListener('click', openDrawer);
    closeBtn?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);

    // Close drawer when any internal navigation link is clicked
    const drawerLinks = drawer?.querySelectorAll<HTMLAnchorElement>('.drawer-link');
    drawerLinks?.forEach((link) => {
      link.addEventListener('click', closeDrawer);
    });

    document.addEventListener('keydown', (e) => {
      if (overlay?.getAttribute('aria-hidden') !== 'false') return;

      if (e.key === 'Escape') {
        e.preventDefault();
        closeDrawer();
      } else if (e.key === 'Tab' && drawer) {
        // Focus trap inside drawer
        const focusableSelectors = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';
        const focusables = Array.from(drawer.querySelectorAll<HTMLElement>(focusableSelectors))
          .filter((el) => el.offsetParent !== null);

        if (focusables.length === 0) return;

        const first = focusables[0];
        const last = focusables[focusables.length - 1];

        if (e.shiftKey) {
          if (document.activeElement === first) {
            e.preventDefault();
            last.focus();
          }
        } else {
          if (document.activeElement === last) {
            e.preventDefault();
            first.focus();
          }
        }
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initMobileNav);
</script>
