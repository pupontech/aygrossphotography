---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import Lightbox from '../components/Lightbox.astro';
import SEO from '../components/SEO.astro';
import type { SiteSettings, SeoData } from '../lib/types';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  noIndex?: boolean;
  schemaType?: 'WebSite' | 'ImageGallery' | 'AboutPage' | 'FAQPage' | 'ContactPage';
  faqs?: Array<{ question: string; answer: string }>;
  settings?: SiteSettings | null;
  pageSeo?: SeoData | null;
}

const {
  title,
  description,
  canonicalUrl,
  image,
  noIndex,
  schemaType,
  faqs,
  settings,
  pageSeo
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f2f0eb" id="theme-color-meta" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme initialization script before CSS to eliminate flash (light mode default) -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('ay-theme');
          if (stored === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            const meta = document.getElementById('theme-color-meta');
            if (meta) meta.setAttribute('content', '#141311');
          } else {
            document.documentElement.setAttribute('data-theme', 'light');
            const meta = document.getElementById('theme-color-meta');
            if (meta) meta.setAttribute('content', '#f2f0eb');
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      image={image}
      noIndex={noIndex}
      schemaType={schemaType}
      faqs={faqs}
      settings={settings}
      pageSeo={pageSeo}
    />
  </head>
  <body>
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <div class="app-shell">
      <!-- Desktop Sidebar -->
      <Sidebar currentPath={currentPath} settings={settings} />

      <!-- Mobile Navigation Bar & Drawer -->
      <MobileNav currentPath={currentPath} settings={settings} />

      <!-- Main Page Content -->
      <main id="main-content" class="main-content" tabindex="-1">
        <slot />
      </main>
    </div>

    <!-- Reusable Accessible Lightbox Dialog -->
    <Lightbox />

    <!-- Global Theme Switcher Runtime Script with Full Accessibility Sync -->
    <script>
      function setupThemeToggles() {
        const toggleDesktop = document.getElementById('theme-toggle-desktop');
        const toggleMobile = document.getElementById('theme-toggle-mobile');

        function updateToggleAttributes(theme: string) {
          const isDark = theme === 'dark';
          const label = isDark ? 'Switch to light mode' : 'Switch to dark mode';
          const themeColor = isDark ? '#141311' : '#f2f0eb';

          const themeColorMeta = document.getElementById('theme-color-meta');
          if (themeColorMeta) {
            themeColorMeta.setAttribute('content', themeColor);
          }

          [toggleDesktop, toggleMobile].forEach((btn) => {
            if (!btn) return;
            btn.setAttribute('aria-pressed', isDark ? 'true' : 'false');
            btn.setAttribute('aria-label', label);
            btn.setAttribute('title', label);
          });
        }

        // Initialize state on load
        const initialTheme = document.documentElement.getAttribute('data-theme') || 'light';
        updateToggleAttributes(initialTheme);

        function toggleTheme() {
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
          const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', nextTheme);
          updateToggleAttributes(nextTheme);
          try {
            localStorage.setItem('ay-theme', nextTheme);
          } catch (e) {}
        }

        toggleDesktop?.addEventListener('click', toggleTheme);
        toggleMobile?.addEventListener('click', toggleTheme);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupThemeToggles);
      } else {
        setupThemeToggles();
      }
    </script>
  </body>
</html>
