---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import MobileNav from '../components/MobileNav.astro';
import Lightbox from '../components/Lightbox.astro';
import SEO from '../components/SEO.astro';
import type { SanitySiteSettings, SanitySEO } from '../lib/sanity/types';

interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  image?: string;
  noIndex?: boolean;
  schemaType?: 'WebSite' | 'ImageGallery' | 'AboutPage' | 'FAQPage' | 'ContactPage';
  faqs?: Array<{ question: string; answer: string }>;
  settings?: SanitySiteSettings | null;
  pageSeo?: SanitySEO | null;
}

const {
  title,
  description,
  canonicalUrl,
  image,
  noIndex,
  schemaType,
  faqs,
  settings,
  pageSeo
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme initialization script before CSS to eliminate flash -->
    <script is:inline>
      (function() {
        try {
          const stored = localStorage.getItem('ay-theme');
          if (stored === 'dark' || stored === 'light') {
            document.documentElement.setAttribute('data-theme', stored);
          } else {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
          }
        } catch (e) {
          // LocalStorage fallback
        }
      })();
    </script>

    <SEO
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      image={image}
      noIndex={noIndex}
      schemaType={schemaType}
      faqs={faqs}
      settings={settings}
      pageSeo={pageSeo}
    />
  </head>
  <body>
    <!-- Accessibility Skip Link -->
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <div class="app-shell">
      <!-- Desktop Sidebar -->
      <Sidebar currentPath={currentPath} settings={settings} />

      <!-- Mobile Navigation Bar & Drawer -->
      <MobileNav currentPath={currentPath} settings={settings} />

      <!-- Main Page Content -->
      <main id="main-content" class="main-content" tabindex="-1">
        <slot />
      </main>
    </div>

    <!-- Reusable Accessible Lightbox Dialog -->
    <Lightbox />

    <!-- Global Theme Switcher Runtime Script -->
    <script>
      function setupThemeToggles() {
        const toggleDesktop = document.getElementById('theme-toggle-desktop');
        const toggleMobile = document.getElementById('theme-toggle-mobile');

        function toggleTheme() {
          const currentTheme = document.documentElement.getAttribute('data-theme') || 'light';
          const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', nextTheme);
          try {
            localStorage.setItem('ay-theme', nextTheme);
          } catch (e) {}
        }

        toggleDesktop?.addEventListener('click', toggleTheme);
        toggleMobile?.addEventListener('click', toggleTheme);
      }

      document.addEventListener('DOMContentLoaded', setupThemeToggles);
    </script>
  </body>
</html>
