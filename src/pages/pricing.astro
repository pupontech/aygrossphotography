---
import Layout from '../layouts/Layout.astro';
import { getPricingPage, getSiteSettings } from '../lib/data';

const [pricingData, settings] = await Promise.all([
  getPricingPage(),
  getSiteSettings()
]);

const title = pricingData.heading || 'Investment & Pricing';
const intro = pricingData.introduction || "Simple, transparent photography packages designed to preserve your family's most meaningful moments.";
const packages = pricingData.packages || [];
---

<Layout
  title={title}
  description={intro}
  canonicalUrl="/pricing"
  settings={settings}
  pageSeo={pricingData.seo}
>
  <div class="pricing-page">
    <header class="page-intro">
      <h1 class="page-title">{title}</h1>
      <p class="page-subtitle">{intro}</p>
    </header>

    <!-- Pricing Cards Grid -->
    <div class="pricing-grid">
      {packages.map((pkg, index) => {
        const isFeatured = index === 1 && packages.length >= 3;
        return (
          <article class={`pricing-card ${isFeatured ? 'pricing-card--featured' : ''}`} style={`animation-delay: ${index * 100 + 100}ms`}>
            {isFeatured && (
              <div class="featured-badge">Most Popular</div>
            )}
            <div class="card-header">
              <h2 class="package-name">{pkg.name}</h2>
              {pkg.shortDescription && (
                <p class="package-desc">{pkg.shortDescription}</p>
              )}
              {pkg.priceText && (
                <div class="price-tag">{pkg.priceText}</div>
              )}
            </div>

            <div class="card-body">
              <ul class="feature-list" role="list">
                {(pkg.features || []).map((feature: string) => (
                  <li class="feature-item">
                    <span class="check-bullet" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="card-footer">
              <a href={pkg.ctaDestination || '/contact'} class={`package-cta ${isFeatured ? 'btn-editorial' : 'btn-secondary'}`}>
                {pkg.ctaLabel || 'Book This Session'}
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Custom Sessions & Print Notice -->
    <section class="pricing-notes-section">
      <h2 class="notes-heading">Custom Sessions & Fine Art Prints</h2>
      <p class="notes-desc">
        Need coverage for multi-day events, destination travel outside Jerusalem, or custom handcrafted heirlooms? Bespoke arrangements and museum-grade archival framing are always available upon request.
      </p>
      <a href="/contact" class="btn-secondary">Inquire for Custom Quote</a>
    </section>
  </div>
</Layout>

<style>
  .pricing-page {
    width: 100%;
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    margin-top: var(--spacing-lg);
  }

  @media (min-width: 900px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: start;
    }
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2.25rem 1.75rem;
    position: relative;
    opacity: 0;
    transform: translateY(12px);
    animation: fadeSlideUp var(--transition-entrance) forwards;
    transition: border-color var(--transition-smooth), transform var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  @keyframes fadeSlideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pricing-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: var(--shadow-card);
  }

  /* Featured card */
  .pricing-card--featured {
    border-color: var(--accent);
    border-top-width: 3px;
  }

  .pricing-card--featured:hover {
    border-color: var(--accent-hover);
    box-shadow: var(--shadow-elevated);
  }

  @media (min-width: 900px) {
    .pricing-card--featured {
      transform: translateY(-4px) scale(1.02);
    }

    .pricing-card--featured:hover {
      transform: translateY(-6px) scale(1.02);
    }
  }

  .featured-badge {
    position: absolute;
    top: -1px;
    right: 1.5rem;
    background-color: var(--accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.35rem 0.85rem;
    border-radius: 0 0 var(--radius-sm) var(--radius-sm);
  }

  .card-header {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .package-name {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
  }

  .package-desc {
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1rem;
    min-height: 2.8rem;
  }

  .price-tag {
    font-family: var(--font-brand);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--accent-text);
  }

  .card-body {
    flex: 1;
    margin-bottom: 2rem;
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .check-bullet {
    color: var(--accent-text);
    flex-shrink: 0;
    margin-top: 1px;
  }

  .card-footer {
    padding-top: 1rem;
  }

  .package-cta {
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  /* Bottom note */
  .pricing-notes-section {
    margin-top: var(--spacing-3xl);
    padding: 3rem 2.5rem;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, color-mix(in srgb, var(--accent-soft) 50%, var(--bg-secondary)) 100%);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    text-align: center;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .notes-heading {
    font-size: 1.35rem;
    margin-bottom: 0.75rem;
  }

  .notes-desc {
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    line-height: 1.7;
  }
</style>
