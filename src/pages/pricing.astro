---
import Layout from '../layouts/Layout.astro';
import { getPricingPage, getSiteSettings } from '../lib/data';

const [pricingData, settings] = await Promise.all([
  getPricingPage(),
  getSiteSettings()
]);

const title = pricingData.heading || 'Packages & Pricing';
const intro = pricingData.introduction || "Straightforward packages for families and events.";
const packages = pricingData.packages || [];
---

<Layout
  title={title}
  description={intro}
  canonicalUrl="/pricing"
  settings={settings}
  pageSeo={pricingData.seo}
>
  <div class="pricing-page">
    <header class="page-intro">
      <h1 class="page-title">{title}</h1>
      <p class="page-subtitle">{intro}</p>
    </header>

    <!-- Pricing Cards Grid -->
    <div class="pricing-grid">
      {packages.map((pkg, index) => {
        const isFeatured = index === 1 && packages.length >= 3;
        return (
          <article class={`pricing-card ${isFeatured ? 'pricing-card--featured' : ''}`}>
            {isFeatured && (
              <div class="featured-badge">For Most Families</div>
            )}
            <div class="card-header">
              <h2 class="package-name">{pkg.name}</h2>
              {pkg.shortDescription && (
                <p class="package-desc">{pkg.shortDescription}</p>
              )}
              {pkg.priceText && (
                <div class="price-tag">{pkg.priceText}</div>
              )}
            </div>

            <div class="card-body">
              <ul class="feature-list" role="list">
                {(pkg.features || []).map((feature: string) => (
                  <li class="feature-item">
                    <span class="check-bullet" aria-hidden="true">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="20 6 9 17 4 12"></polyline>
                      </svg>
                    </span>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="card-footer">
              <a href={pkg.ctaDestination || '/contact'} class={`package-cta ${isFeatured ? 'btn-editorial' : 'btn-secondary'}`}>
                {pkg.ctaLabel || 'Book This Session'}
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Custom Sessions & Print Notice -->
    <section class="pricing-notes-section">
      <h2 class="notes-heading">Custom Sessions & Prints</h2>
      <p class="notes-desc">
        Need coverage for multi-day events or travel outside Jerusalem? Custom packages and professional print options are always available — just ask.
      </p>
      <a href="/contact" class="btn-secondary">Inquire for Custom Quote</a>
    </section>
  </div>
</Layout>

<style>
  .pricing-page {
    width: 100%;
    margin-bottom: var(--spacing-3xl);
  }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: var(--spacing-2xl);
  }

  @media (min-width: 900px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
      gap: 2.25rem;
    }
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 2.5rem 2rem 2.25rem;
    position: relative;
    opacity: 0;
    transform: translateY(12px);
    animation: fadeSlideUp var(--transition-entrance) forwards;
    transition: border-color var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  @keyframes fadeSlideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .pricing-card:hover {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  /* Featured card - subtle distinction without aggressive transforms */
  .pricing-card--featured {
    border-color: var(--accent);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    left: 2rem;
    background-color: var(--accent);
    color: var(--bg-primary);
    font-family: var(--font-sans);
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-sm);
  }

  .card-header {
    margin-bottom: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .package-name {
    font-family: var(--font-brand);
    font-size: 1.65rem;
    font-weight: 300;
    letter-spacing: 0.03em;
    color: var(--text-primary);
    margin-bottom: 0.65rem;
    line-height: 1.2;
  }

  .package-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 1.25rem;
    min-height: 2.8rem;
  }

  .price-tag {
    font-family: var(--font-brand);
    font-size: 1.85rem;
    font-weight: 300;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  .card-body {
    flex: 1;
    margin-bottom: 2.25rem;
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.95rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .check-bullet {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .card-footer {
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .package-cta {
    width: 100%;
    justify-content: center;
    text-align: center;
  }

  /* Bottom note */
  .pricing-notes-section {
    margin-top: var(--spacing-3xl);
    padding: 3.5rem 2.5rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    text-align: center;
    max-width: 750px;
    margin-left: auto;
    margin-right: auto;
  }

  .notes-heading {
    font-family: var(--font-brand);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    margin-bottom: 0.85rem;
  }

  .notes-desc {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.8;
    font-size: 0.95rem;
  }
</style>
