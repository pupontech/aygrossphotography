---
import Layout from '../layouts/Layout.astro';
import PhotoImage from '../components/PhotoImage.astro';
import { getAboutPage, getSiteSettings } from '../lib/data';

const [aboutData, settings] = await Promise.all([
  getAboutPage(),
  getSiteSettings()
]);

const title = aboutData.title || 'About AY Gross';
const bio: string[] = aboutData.bioParagraphs || [];
---

<Layout
  title={title}
  description="Learn more about AY Gross, family and event photographer based in Jerusalem, Israel."
  canonicalUrl="/about"
  schemaType="AboutPage"
  settings={settings}
  pageSeo={aboutData.seo}
>
  <div class="about-page">
    <header class="page-intro">
      <h1 class="page-title">{title}</h1>
      <p class="page-subtitle">Based in Jerusalem. Available across Israel.</p>
    </header>

    <div class="about-editorial-grid">
      <!-- Portrait Column -->
      {aboutData.portrait && (
        <div class="about-portrait-wrapper">
          <PhotoImage
            image={aboutData.portrait}
            alt="AY Gross with camera"
            loading="eager"
            fetchpriority="high"
            width={1152}
            height={2048}
            aspectRatio={1152 / 2048}
            sizes="(max-width: 768px) 100vw, 420px"
            class="about-portrait-img"
          />
          <span class="portrait-caption">AY Gross — Jerusalem, Israel</span>
        </div>
      )}

      <!-- Bio Column -->
      <div class="about-content-column">
        <div class="prose">
          {bio.map((paragraph: string) => (
            <p>{paragraph}</p>
          ))}
        </div>

        <div class="about-highlights">
          <div class="highlight-item">
            <span class="highlight-number">2017</span>
            <span class="highlight-label">Aliyah to Israel</span>
          </div>
          <div class="highlight-item">
            <span class="highlight-number">100+</span>
            <span class="highlight-label">Families Photographed</span>
          </div>
          <div class="highlight-item">
            <span class="highlight-number">10 Days</span>
            <span class="highlight-label">Turnaround Time</span>
          </div>
        </div>

        <div class="about-cta">
          <a href="/contact" class="btn-editorial">Let's Connect</a>
          <a href="/faq" class="btn-secondary">Read FAQ</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about-page {
    width: 100%;
    margin-bottom: var(--spacing-3xl);
  }

  .about-editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    align-items: start;
    margin-top: var(--spacing-2xl);
  }

  @media (min-width: 900px) {
    .about-editorial-grid {
      grid-template-columns: 420px 1fr;
      gap: 5rem;
    }
  }

  .about-portrait-wrapper {
    position: relative;
    opacity: 0;
    animation: fadeSlideUp var(--transition-entrance) 100ms forwards;
  }

  @keyframes fadeSlideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  :global(.about-portrait-img) {
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
  }

  .portrait-caption {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: 1rem;
  }

  .about-content-column {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    opacity: 0;
    animation: fadeSlideUp var(--transition-entrance) 200ms forwards;
  }

  .about-highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    padding: 2.25rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .highlight-item {
    display: flex;
    flex-direction: column;
  }

  .highlight-number {
    font-family: var(--font-brand);
    font-size: clamp(1.75rem, 2.5vw, 2.25rem);
    font-weight: 400;
    color: var(--text-primary);
    line-height: 1.1;
  }

  .highlight-label {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.14em;
    margin-top: 0.5rem;
  }

  .about-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    align-items: center;
  }
</style>
