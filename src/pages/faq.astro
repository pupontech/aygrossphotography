---
import Layout from '../layouts/Layout.astro';
import { getFaqPage, getSiteSettings } from '../lib/data';

const [faqData, settings] = await Promise.all([
  getFaqPage(),
  getSiteSettings()
]);

const title = faqData.title || 'Frequently Asked Questions';
const faqs = faqData.faqs || [];
---

<Layout
  title={title}
  description="Common questions about family and event photography sessions, turnaround times, locations, and preparation with AY Gross."
  canonicalUrl="/faq"
  schemaType="FAQPage"
  faqs={faqs}
  settings={settings}
  pageSeo={faqData.seo}
>
  <div class="faq-page">
    <header class="page-intro">
      <h1 class="page-title">{title}</h1>
      <p class="page-subtitle">Common questions about sessions, timing, and delivery.</p>
    </header>

    <div class="faq-accordion-list">
      {faqs.map((faq, index) => (
        <details class="faq-item" id={`faq-${index + 1}`} open={index === 0}>
          <summary class="faq-question">
            <span class="question-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            <span class="question-text">{faq.question}</span>
            <span class="toggle-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Need more info CTA -->
    <section class="faq-footer-cta">
      <h2 class="faq-footer-title">Have a specific question not covered here?</h2>
      <p class="faq-footer-desc">I am happy to discuss your schedule, location ideas, or custom event requirements.</p>
      <a href="/contact" class="btn-editorial">Get in Touch</a>
    </section>
  </div>
</Layout>

<style>
  .faq-page {
    width: 100%;
    max-width: 840px;
    margin-bottom: var(--spacing-3xl);
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: var(--spacing-2xl);
  }

  .faq-item {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    transition: border-color var(--transition-smooth), box-shadow var(--transition-smooth);
    overflow: hidden;
    opacity: 0;
    transform: translateY(10px);
    animation: fadeSlideUp var(--transition-entrance) forwards;
  }

  @keyframes fadeSlideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .faq-item[open] {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }

  .faq-question {
    display: flex;
    align-items: center;
    padding: 1.4rem 1.75rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-family: var(--font-brand);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    transition: color var(--transition-smooth);
    gap: 1.25rem;
  }

  /* Remove default webkit triangle */
  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--accent);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  .question-index {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.1em;
    flex-shrink: 0;
    min-width: 1.5rem;
  }

  .question-text {
    flex: 1;
  }

  .toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: transform var(--transition-smooth), color var(--transition-smooth);
    flex-shrink: 0;
  }

  .faq-item[open] .toggle-icon {
    transform: rotate(180deg);
    color: var(--text-primary);
  }

  .faq-answer {
    padding: 0 1.75rem 1.75rem;
    padding-left: calc(1.75rem + 1.25rem + 1.5rem);
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.85;
    border-top: 1px solid transparent;
  }

  .faq-item[open] .faq-answer {
    border-top-color: var(--border-subtle);
    padding-top: 1.25rem;
  }

  /* Bottom CTA */
  .faq-footer-cta {
    margin-top: var(--spacing-3xl);
    padding: 3.5rem 2.5rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    text-align: center;
  }

  .faq-footer-title {
    font-family: var(--font-brand);
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
  }

  .faq-footer-desc {
    color: var(--text-secondary);
    margin-bottom: 2rem;
    line-height: 1.8;
    font-size: 0.95rem;
  }
</style>
