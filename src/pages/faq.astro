---
import Layout from '../layouts/Layout.astro';
import { getFaqPage, getSiteSettings } from '../lib/sanity/client';

const [faqData, settings] = await Promise.all([
  getFaqPage(),
  getSiteSettings()
]);

const title = faqData.title || 'Frequently Asked Questions';
const faqs = faqData.faqs || [];
---

<Layout
  title={title}
  description="Common questions about family and event photography sessions, turnaround times, locations, and preparation with AY Gross."
  canonicalUrl="/faq"
  schemaType="FAQPage"
  faqs={faqs}
  settings={settings}
  pageSeo={faqData.seo}
>
  <div class="faq-page">
    <header class="page-intro">
      <h1 class="page-title">{title}</h1>
      <p class="page-subtitle">Everything you need to know about preparing for your session and receiving your photographs.</p>
    </header>

    <div class="faq-accordion-list">
      {faqs.map((faq, index) => (
        <details class="faq-item" id={`faq-${index + 1}`} open={index === 0}>
          <summary class="faq-question">
            <span class="question-text">{faq.question}</span>
            <span class="toggle-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

    <!-- Need more info CTA -->
    <section class="faq-footer-cta">
      <h2 class="faq-footer-title">Have a specific question not covered here?</h2>
      <p class="faq-footer-desc">I am happy to discuss your schedule, location ideas, or custom event requirements.</p>
      <a href="/contact" class="btn-editorial">Get in Touch</a>
    </section>
  </div>
</Layout>

<style>
  .faq-page {
    width: 100%;
    max-width: 860px;
  }

  .faq-accordion-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: var(--spacing-lg);
  }

  .faq-item {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    transition: border-color var(--transition-smooth);
    overflow: hidden;
  }

  .faq-item[open] {
    border-color: var(--border-strong);
  }

  .faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.35rem 1.5rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-family: var(--font-brand);
    font-size: 1.15rem;
    color: var(--text-primary);
    transition: color var(--transition-smooth);
  }

  /* Remove default webkit triangle */
  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-question:hover {
    color: var(--text-primary);
  }

  .faq-question:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: -2px;
  }

  .question-text {
    padding-right: 1rem;
  }

  .toggle-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: transform var(--transition-smooth), color var(--transition-smooth);
    flex-shrink: 0;
  }

  .faq-item[open] .toggle-icon {
    transform: rotate(180deg);
    color: var(--text-primary);
  }

  .faq-answer {
    padding: 0 1.5rem 1.5rem;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1.75;
    border-top: 1px solid transparent;
  }

  .faq-item[open] .faq-answer {
    border-top-color: var(--border-subtle);
    padding-top: 1rem;
  }

  /* Bottom CTA */
  .faq-footer-cta {
    margin-top: var(--spacing-2xl);
    padding: 2.5rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: 2px;
    text-align: center;
  }

  .faq-footer-title {
    font-size: 1.35rem;
    margin-bottom: 0.5rem;
  }

  .faq-footer-desc {
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }
</style>
