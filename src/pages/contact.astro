---
import Layout from '../layouts/Layout.astro';
import { getContactPage, getSiteSettings } from '../lib/data';

const [contactData, settings] = await Promise.all([
  getContactPage(),
  getSiteSettings()
]);

const title = contactData.heading || 'Get in Touch';
const intro = contactData.intro || "Whether you are planning a family portrait session in Jerusalem or an upcoming celebration, I'd love to hear from you.";

const email = contactData.email || settings?.email || 'aygrossphotography@gmail.com';
const phone = contactData.phone || settings?.phone || '058-772-5628';
const phoneTel = phone.startsWith('+') ? phone.replace(/[^0-9+]/g, '') : `+972${phone.replace(/^0/, '').replace(/[^0-9]/g, '')}`;
const whatsapp = contactData.whatsApp || contactData.whatsapp || settings?.whatsApp || settings?.whatsapp || '+972 58-772-5628';
const whatsappClean = whatsapp.replace(/[^0-9]/g, '');
const location = contactData.location || settings?.location || 'Kiryat Yearim, Jerusalem & all of Israel';
const letterbirdUsername = contactData.letterbirdUser || contactData.letterbirdUsername || 'aygrossphotography';
---

<Layout
  title={title}
  description="Contact AY Gross Photography to schedule your family portrait session or event coverage in Jerusalem and throughout Israel."
  canonicalUrl="/contact"
  schemaType="ContactPage"
  settings={settings}
  pageSeo={contactData.seo}
>
  <div class="contact-page">
    <header class="page-intro">
      <h1 class="page-title">{title}</h1>
      <p class="page-subtitle">{intro}</p>
    </header>

    <div class="contact-layout-grid">
      <!-- Direct Contact Details -->
      <aside class="contact-details-column">
        <h2 class="column-title">Direct Details</h2>

        <div class="contact-cards-stack">
          <!-- Email -->
          <div class="contact-info-card">
            <span class="info-label">Email</span>
            <a href={`mailto:${email}`} class="info-link">{email}</a>
          </div>

          <!-- Phone -->
          <div class="contact-info-card">
            <span class="info-label">Telephone</span>
            <a href={`tel:${phoneTel}`} class="info-link">{phone}</a>
          </div>

          <!-- WhatsApp -->
          <a
            href={`https://wa.me/${whatsappClean}`}
            target="_blank"
            rel="noopener noreferrer"
            class="whatsapp-card"
          >
            <span class="whatsapp-icon" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </span>
            <span class="whatsapp-text">
              <span class="whatsapp-label">WhatsApp</span>
              <span class="whatsapp-number">{whatsapp}</span>
            </span>
            <span class="whatsapp-arrow" aria-hidden="true">→</span>
          </a>

          <!-- Location -->
          <div class="contact-info-card">
            <span class="info-label">Base & Coverage</span>
            <p class="info-text">{location}</p>
          </div>
        </div>

        <div class="booking-notice">
          <h3 class="notice-heading">Availability Notice</h3>
          <p class="notice-desc">
            Weekend and holiday season dates book several months in advance. Please reach out early to secure your preferred date and golden hour window.
          </p>
        </div>
      </aside>

      <!-- Letterbird Embed Column -->
      <section class="contact-form-column" aria-label="Inquiry Message Form">
        <h2 class="column-title">Send a Message</h2>
        <div class="letterbird-wrapper">
          <iframe
            src={`https://letterbird.co/embed/${letterbirdUsername}`}
            title="Inquiry contact form via Letterbird"
            class="letterbird-iframe"
            loading="lazy"
          ></iframe>
          <div class="letterbird-fallback">
            <p>Prefer standard messaging? You can also <a href={`https://letterbird.co/${letterbirdUsername}`} target="_blank" rel="noopener noreferrer">open the form in a new tab</a> or email directly at <a href={`mailto:${email}`}>{email}</a>.</p>
          </div>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .contact-page {
    width: 100%;
  }

  .contact-layout-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
    margin-top: var(--spacing-lg);
  }

  @media (min-width: 900px) {
    .contact-layout-grid {
      grid-template-columns: 360px 1fr;
      gap: 4rem;
    }
  }

  .column-title {
    font-size: 1.2rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .contact-details-column {
    opacity: 0;
    animation: fadeSlideUp var(--transition-entrance) 100ms forwards;
  }

  .contact-form-column {
    opacity: 0;
    animation: fadeSlideUp var(--transition-entrance) 200ms forwards;
  }

  @keyframes fadeSlideUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .contact-cards-stack {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .contact-info-card {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.15rem 1.35rem;
    border-left: 2px solid transparent;
    transition: border-color var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .contact-info-card:hover {
    border-left-color: var(--accent);
    box-shadow: var(--shadow-soft);
  }

  .info-label {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }

  .info-link {
    font-size: 1rem;
    color: var(--text-primary);
    font-weight: 500;
    transition: color var(--transition-smooth);
  }

  .info-link:hover {
    color: var(--accent-text);
  }

  .info-text {
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  /* WhatsApp card */
  .whatsapp-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.25rem;
    background-color: #075e54;
    border: 1px solid #128c7e;
    border-radius: var(--radius-md);
    color: #fff;
    text-decoration: none;
    transition: background-color var(--transition-smooth), transform var(--transition-smooth), box-shadow var(--transition-smooth);
  }

  .whatsapp-card:hover {
    background-color: #128c7e;
    transform: translateY(-1px);
    box-shadow: 0 4px 16px rgba(7, 94, 84, 0.3);
    color: #fff;
  }

  .whatsapp-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    opacity: 0.9;
  }

  .whatsapp-text {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .whatsapp-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.7;
  }

  .whatsapp-number {
    font-size: 0.95rem;
    font-weight: 500;
  }

  .whatsapp-arrow {
    font-size: 1.1rem;
    opacity: 0.6;
    transition: opacity var(--transition-smooth), transform var(--transition-smooth);
  }

  .whatsapp-card:hover .whatsapp-arrow {
    opacity: 1;
    transform: translateX(3px);
  }

  /* Booking notice */
  .booking-notice {
    padding: 1.5rem;
    background-color: var(--bg-secondary);
    border-left: 2px solid var(--accent);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .notice-heading {
    font-size: 1rem;
    margin-bottom: 0.4rem;
  }

  .notice-desc {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Letterbird embed */
  .letterbird-wrapper {
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1rem;
    min-height: 520px;
    display: flex;
    flex-direction: column;
  }

  .letterbird-iframe {
    width: 100%;
    min-height: 500px;
    border: none;
    background: transparent;
    flex: 1;
    border-radius: var(--radius-sm);
  }

  .letterbird-fallback {
    margin-top: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border-subtle);
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .letterbird-fallback a {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
    transition: color var(--transition-smooth);
  }

  .letterbird-fallback a:hover {
    color: var(--accent-text);
  }
</style>
