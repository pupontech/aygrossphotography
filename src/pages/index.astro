---
import Layout from '../layouts/Layout.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeIntro from '../components/HomeIntro.astro';
import FeaturedGalleries from '../components/FeaturedGalleries.astro';
import HomeTestimonials from '../components/HomeTestimonials.astro';
import HomeContact from '../components/HomeContact.astro';
import { getHomePage, getSiteSettings, getTestimonials, getContactPage } from '../lib/data';

const [homeData, settings, testimonials, contactData] = await Promise.all([
  getHomePage(),
  getSiteSettings(),
  getTestimonials(),
  getContactPage()
]);

const pageTitle = 'Family Portraits & Events';
const pageDescription = homeData.seo?.metaDescription || homeData.supportingCopy;
---

<Layout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl="/"
  schemaType="WebSite"
  settings={settings}
  pageSeo={homeData.seo}
>
  <div class="homepage-container">
    <!-- 1. Hero Photography Slider (Full Width, Auto-Advancing) -->
    <HomeHero
      slides={homeData.heroSlides}
      descriptor={homeData.heroDescriptor}
    />

    <!-- 2. Centered Orientation / The Approach -->
    <HomeIntro
      heading={homeData.introHeading}
      paragraphs={homeData.introText}
      ctaLabel="Explore All Portfolios"
      ctaDestination="/portraits"
    />

    <!-- 3. Featured portfolios -->
    {homeData.featuredGalleries && homeData.featuredGalleries.length > 0 && (
      <FeaturedGalleries
        galleries={homeData.featuredGalleries}
        eyebrow="Portfolios"
        title="Featured Galleries"
      />
    )}

    <!-- 4. Testimonials -->
    {testimonials && testimonials.length > 0 && (
      <HomeTestimonials
        testimonials={testimonials}
        eyebrow="From Recent Sessions"
        title="What Families Say"
      />
    )}

    <!-- 5. Contact & Booking Inquiry (Letterbird) -->
    <HomeContact
      heading="Inquire About a Session"
      intro={contactData.intro}
      letterbirdUser={contactData.letterbirdUser || 'aygrossphotography'}
      email={contactData.email || settings?.email}
      phone={contactData.phone || settings?.phone}
      location={contactData.location || settings?.location}
      responseTime={contactData.responseTime}
    />
  </div>
</Layout>

<style>
  .homepage-container {
    width: 100%;
  }
</style>
