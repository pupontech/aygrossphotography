---
import Layout from '../layouts/Layout.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import PhotoImage from '../components/PhotoImage.astro';
import {
  getHomePage,
  getSiteSettings,
  getTestimonials,
  getAboutPage,
  getPricingPage,
  getFaqPage,
  getContactPage,
  portraitsGallery,
  eventsGallery
} from '../lib/data';

const [
  homeData,
  settings,
  testimonials,
  aboutData,
  pricingData,
  faqData,
  contactData
] = await Promise.all([
  getHomePage(),
  getSiteSettings(),
  getTestimonials(),
  getAboutPage(),
  getPricingPage(),
  getFaqPage(),
  getContactPage()
]);

const portraitPhotos = portraitsGallery?.photos || [];
const eventPhotos = eventsGallery?.photos || [];
const packages = pricingData.packages || [];
const faqs = faqData.faqs || [];
const bioParagraphs = aboutData.bioParagraphs || aboutData.bio || [];

const email = contactData.email || settings?.email || 'aygrossphotography@gmail.com';
const phone = contactData.phone || settings?.phone || '058-772-5628';
const phoneTel = phone.startsWith('+') ? phone.replace(/[^0-9+]/g, '') : `+972${phone.replace(/^0/, '').replace(/[^0-9]/g, '')}`;
const whatsapp = contactData.whatsApp || contactData.whatsapp || settings?.whatsApp || settings?.whatsapp || '+972 58-772-5628';
const whatsappClean = whatsapp.replace(/[^0-9]/g, '');
const locationText = contactData.location || settings?.location || 'Kiryat Yearim, Jerusalem & all of Israel';
---

<Layout
  title="Fine Art Family & Event Photography"
  description={homeData.supportingCopy || 'Jerusalem & Israel based photographer specializing in natural family portraits, kids, and events.'}
  canonicalUrl="/"
  settings={settings}
  pageSeo={homeData.seo}
  faqs={faqs}
>
  <div class="onepage-container">
    <!-- 1. Hero Introduction -->
    <header id="hero" class="page-intro hero-intro">
      <h1 class="page-title hero-title">{homeData.heading || 'Moments framed with heart and light.'}</h1>
      {homeData.supportingCopy && (
        <p class="page-subtitle hero-subtitle">{homeData.supportingCopy}</p>
      )}
      <div class="hero-actions">
        <a href="#portraits" class="btn-editorial">Explore Portraits</a>
        <a href="#events" class="btn-secondary">View Events</a>
        <a href="#pricing" class="btn-secondary">Pricing</a>
        <a href="#contact" class="btn-editorial btn-accent-gold">Book a Session</a>
      </div>
    </header>

    <!-- 2. Portraits Gallery Section -->
    <section id="portraits" class="page-section" aria-label="Portraits and Family Stories">
      <div class="section-divider"></div>
      <header class="section-header">
        <span class="section-eyebrow">Portraits & Family Stories</span>
        <h2 class="section-heading">Family & Portrait Photography</h2>
        <p class="section-sub">Intimate, natural family portraits captured across the hills and historic landscapes of Jerusalem and Israel.</p>
      </header>
      <div class="gallery-wrapper">
        <PhotoGrid photos={portraitPhotos} galleryTitle="Family Portraits" />
      </div>
    </section>

    <!-- 3. Events Gallery Section -->
    <section id="events" class="page-section" aria-label="Celebrations and Events">
      <div class="section-divider"></div>
      <header class="section-header">
        <span class="section-eyebrow">Celebrations & Simchas</span>
        <h2 class="section-heading">Event Photography</h2>
        <p class="section-sub">Heartfelt, authentic storytelling for Bar & Bat Mitzvahs, Brit Milahs, and family celebrations.</p>
      </header>
      <div class="gallery-wrapper">
        <PhotoGrid photos={eventPhotos} galleryTitle="Event Photography" />
      </div>
    </section>

    <!-- 4. About Me Section -->
    <section id="about" class="page-section" aria-label="About the Photographer">
      <div class="section-divider"></div>
      <header class="section-header">
        <span class="section-eyebrow">The Photographer</span>
        <h2 class="section-heading">{aboutData.title || 'About AY Gross'}</h2>
        <p class="section-sub">Capturing genuine family stories across the landscapes of Israel.</p>
      </header>

      <div class="about-editorial-grid">
        {aboutData.portrait && (
          <div class="about-portrait-wrapper">
            <PhotoImage
              image={aboutData.portrait}
              alt="AY Gross with camera"
              loading="lazy"
              width={1152}
              height={2048}
              aspectRatio={1152 / 2048}
              sizes="(max-width: 768px) 100vw, 420px"
              class="about-portrait-img"
            />
            <span class="portrait-caption">AY Gross — Jerusalem, Israel</span>
          </div>
        )}

        <div class="about-content-column">
          <div class="prose prose--dropcap">
            {bioParagraphs.map((p: string) => (
              <p>{p}</p>
            ))}
          </div>

          <div class="about-highlights">
            <div class="highlight-item">
              <span class="highlight-number">2017</span>
              <span class="highlight-label">Aliyah to Israel</span>
            </div>
            <div class="highlight-item">
              <span class="highlight-number">100+</span>
              <span class="highlight-label">Families Photographed</span>
            </div>
            <div class="highlight-item">
              <span class="highlight-number">10 Days</span>
              <span class="highlight-label">Turnaround Time</span>
            </div>
          </div>

          <div class="about-actions">
            <a href="#contact" class="btn-editorial">Inquire About a Session</a>
            <a href="#pricing" class="btn-secondary">View Pricing</a>
          </div>
        </div>
      </div>
    </section>

    <!-- 5. Investment & Pricing Section -->
    <section id="pricing" class="page-section" aria-label="Investment and Session Packages">
      <div class="section-divider"></div>
      <header class="section-header">
        <span class="section-eyebrow">Investment</span>
        <h2 class="section-heading">{pricingData.heading || 'Simple, Transparent Pricing'}</h2>
        <p class="section-sub">{pricingData.introduction || "Simple, transparent photography packages designed to preserve your family's most meaningful moments."}</p>
      </header>

      <div class="pricing-grid">
        {packages.map((pkg, index) => {
          const isFeatured = index === 1 && packages.length >= 3;
          return (
            <article class={`pricing-card ${isFeatured ? 'pricing-card--featured' : ''}`}>
              {isFeatured && <div class="featured-badge">Most Popular</div>}
              <div class="card-header">
                <h3 class="package-name">{pkg.name}</h3>
                {pkg.shortDescription && <p class="package-desc">{pkg.shortDescription}</p>}
                {pkg.priceText && <div class="price-tag">{pkg.priceText}</div>}
              </div>

              <div class="card-body">
                <ul class="feature-list" role="list">
                  {(pkg.features || []).map((feature: string) => (
                    <li class="feature-item">
                      <span class="check-bullet" aria-hidden="true">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                      </span>
                      <span>{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="card-footer">
                <a href="#contact" class={`package-cta ${isFeatured ? 'btn-editorial' : 'btn-secondary'}`}>
                  {pkg.ctaLabel || 'Book This Session'}
                </a>
              </div>
            </article>
          );
        })}
      </div>

      <div class="pricing-notes-section">
        <h3 class="notes-heading">Custom Sessions & Fine Art Prints</h3>
        <p class="notes-desc">
          Need coverage for multi-day events, destination travel outside Jerusalem, or custom handcrafted heirlooms? Bespoke arrangements and museum-grade archival framing are always available upon request.
        </p>
        <a href="#contact" class="btn-secondary">Inquire for Custom Quote</a>
      </div>
    </section>

    <!-- 6. Client Testimonials Section -->
    {testimonials.length > 0 && (
      <section id="testimonials" class="page-section" aria-label="Client Reflections">
        <div class="section-divider"></div>
        <header class="section-header">
          <span class="section-eyebrow">Client Reflections</span>
          <h2 class="section-heading">Kind Words from Families</h2>
        </header>

        <div class="testimonials-grid">
          {testimonials.map((item) => (
            <blockquote class="testimonial-card">
              <div class="quote-glyph" aria-hidden="true">"</div>
              <p class="testimonial-quote">{item.quote}</p>
              <footer class="testimonial-author">— {item.clientName}</footer>
            </blockquote>
          ))}
        </div>
      </section>
    )}

    <!-- 7. Frequently Asked Questions Section -->
    {faqs.length > 0 && (
      <section id="faq" class="page-section faq-section-container" aria-label="Frequently Asked Questions">
        <div class="section-divider"></div>
        <header class="section-header">
          <span class="section-eyebrow">Questions & Answers</span>
          <h2 class="section-heading">{faqData.title || 'Frequently Asked Questions'}</h2>
          <p class="section-sub">{faqData.intro || 'Answers to common questions about preparing for your family portrait session or event.'}</p>
        </header>

        <div class="faq-accordion-list">
          {faqs.map((faq, index) => (
            <details class="faq-item" id={`faq-${index + 1}`} open={index === 0}>
              <summary class="faq-question">
                <span class="question-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
                <span class="question-text">{faq.question}</span>
                <span class="toggle-icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"></polyline>
                  </svg>
                </span>
              </summary>
              <div class="faq-answer">
                <p>{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </section>
    )}

    <!-- 8. Contact & Booking Inquiry Section -->
    <section id="contact" class="page-section" aria-label="Booking Inquiry and Contact Details">
      <div class="section-divider"></div>
      <header class="section-header">
        <span class="section-eyebrow">Let's Connect</span>
        <h2 class="section-heading">{contactData.heading || 'Get in Touch'}</h2>
        <p class="section-sub">{contactData.intro || "Whether you are planning a family portrait session in Jerusalem or an upcoming celebration, I'd love to hear from you."}</p>
      </header>

      <div class="contact-layout-grid">
        <!-- Direct Contact Details -->
        <aside class="contact-details-column">
          <h3 class="column-title">Direct Details</h3>

          <div class="contact-cards-stack">
            <div class="contact-info-card">
              <span class="info-label">Email</span>
              <a href={`mailto:${email}`} class="info-link">{email}</a>
            </div>

            <div class="contact-info-card">
              <span class="info-label">Telephone</span>
              <a href={`tel:${phoneTel}`} class="info-link">{phone}</a>
            </div>

            <a
              href={`https://wa.me/${whatsappClean}`}
              target="_blank"
              rel="noopener noreferrer"
              class="whatsapp-card"
            >
              <span class="whatsapp-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </span>
              <span class="whatsapp-text">
                <span class="whatsapp-label">WhatsApp</span>
                <span class="whatsapp-number">{whatsapp}</span>
              </span>
              <span class="whatsapp-arrow" aria-hidden="true">→</span>
            </a>

            <div class="location-card">
              <span class="location-icon" aria-hidden="true">📍</span>
              <div>
                <span class="location-label">Service Area</span>
                <p class="location-desc">{locationText}</p>
              </div>
            </div>
          </div>
        </aside>

        <!-- Booking Inquiry Form -->
        <section class="contact-form-column" aria-label="Send a Message">
          <div class="form-container-card">
            <h3 class="form-card-title">Send a Message</h3>
            <p class="form-card-subtitle">Fill out the details below and I will respond within 24 hours.</p>

            <form
              class="inquiry-form"
              id="booking-inquiry-form"
              action={`mailto:${email}`}
              method="GET"
              enctype="text/plain"
            >
              <div class="form-row">
                <div class="form-group">
                  <label for="form-name" class="form-label">Your Name <span class="required">*</span></label>
                  <input type="text" id="form-name" name="name" class="form-input" required placeholder="Sarah Klein" autocomplete="name" />
                </div>
                <div class="form-group">
                  <label for="form-email" class="form-label">Email Address <span class="required">*</span></label>
                  <input type="email" id="form-email" name="email" class="form-input" required placeholder="sarah@example.com" autocomplete="email" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="form-phone" class="form-label">Phone / WhatsApp</label>
                  <input type="tel" id="form-phone" name="phone" class="form-input" placeholder="+972-50-000-0000" autocomplete="tel" />
                </div>
                <div class="form-group">
                  <label for="form-session-type" class="form-label">Session Type</label>
                  <select id="form-session-type" name="session_type" class="form-select">
                    <option value="Family Portrait Session">Family Portrait Session</option>
                    <option value="Bar / Bat Mitzvah">Bar / Bat Mitzvah</option>
                    <option value="Brit Milah / Intimate Simcha">Brit Milah / Intimate Simcha</option>
                    <option value="Mini Session">Mini Session</option>
                    <option value="Custom / Other">Custom / Other</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="form-message" class="form-label">Tell Me About Your Vision <span class="required">*</span></label>
                <textarea id="form-message" name="body" class="form-textarea" rows="4" required placeholder="Tell me about your family, event dates, preferred outdoor locations in Jerusalem, or any special requests..."></textarea>
              </div>

              <button type="submit" class="btn-editorial form-submit-btn">
                Send Booking Inquiry
                <span class="btn-arrow" aria-hidden="true">→</span>
              </button>
            </form>
          </div>
        </section>
      </div>
    </section>
  </div>
</Layout>

<style>
  .onepage-container {
    width: 100%;
  }

  /* Hero Section */
  .hero-intro {
    animation: heroEnter 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
    margin-bottom: var(--spacing-2xl);
  }

  @keyframes heroEnter {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .hero-title {
    letter-spacing: -0.02em;
  }

  .hero-subtitle {
    max-width: 640px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 1.5rem;
  }

  .btn-accent-gold {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #131210;
  }

  .btn-accent-gold:hover {
    background-color: transparent;
    color: var(--accent-hover);
    border-color: var(--accent-hover);
  }

  /* Section Styling */
  .page-section {
    margin-bottom: var(--spacing-3xl);
  }

  .section-header {
    margin-bottom: var(--spacing-xl);
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: 0.5rem;
  }

  .section-heading {
    font-size: clamp(1.8rem, 3.2vw, 2.75rem);
    font-family: var(--font-brand);
    color: var(--text-primary);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .section-sub {
    font-size: 1.05rem;
    color: var(--text-secondary);
    max-width: 680px;
    line-height: 1.6;
  }

  .gallery-wrapper {
    margin-top: var(--spacing-md);
  }

  /* About Me Section */
  .about-editorial-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: start;
    margin-top: var(--spacing-lg);
  }

  @media (min-width: 900px) {
    .about-editorial-grid {
      grid-template-columns: 380px 1fr;
      gap: 3.5rem;
    }
  }

  .about-portrait-wrapper {
    position: relative;
    border-radius: var(--radius-md);
    overflow: hidden;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
  }

  .about-portrait-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: 1152 / 2048;
  }

  .portrait-caption {
    display: block;
    padding: 0.75rem 1rem;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-family: var(--font-serif);
    font-style: italic;
    background-color: var(--bg-secondary);
    border-top: 1px solid var(--border-subtle);
  }

  .about-content-column {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .about-highlights {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding: 1.75rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
  }

  .highlight-item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .highlight-number {
    font-family: var(--font-brand);
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    color: var(--accent);
    font-weight: 600;
  }

  .highlight-label {
    font-size: 0.82rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .about-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
  }

  /* Pricing Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-top: var(--spacing-lg);
  }

  @media (min-width: 860px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.75rem;
      align-items: stretch;
    }
  }

  .pricing-card {
    display: flex;
    flex-direction: column;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2.25rem 1.75rem;
    position: relative;
    transition: transform var(--transition-smooth), box-shadow var(--transition-smooth), border-color var(--transition-smooth);
  }

  .pricing-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
    border-color: var(--border-strong);
  }

  .pricing-card--featured {
    border-color: var(--accent);
    background-color: color-mix(in srgb, var(--accent-soft) 25%, var(--bg-secondary));
    box-shadow: var(--shadow-elevated);
  }

  .featured-badge {
    position: absolute;
    top: -12px;
    right: 1.5rem;
    background-color: var(--accent);
    color: #131210;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.25rem 0.75rem;
    border-radius: 100px;
  }

  .package-name {
    font-size: 1.4rem;
    font-family: var(--font-brand);
    color: var(--text-primary);
    margin-bottom: 0.4rem;
  }

  .package-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    min-height: 2.5rem;
    margin-bottom: 1.25rem;
  }

  .price-tag {
    font-family: var(--font-brand);
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--accent-text);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.5rem;
  }

  .feature-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }

  .feature-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .check-bullet {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .card-footer {
    margin-top: auto;
  }

  .package-cta {
    width: 100%;
    justify-content: center;
  }

  .pricing-notes-section {
    margin-top: 3rem;
    padding: 2.5rem 2rem;
    background-color: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    text-align: center;
    max-width: 820px;
    margin-left: auto;
    margin-right: auto;
  }

  .notes-heading {
    font-size: 1.3rem;
    font-family: var(--font-brand);
    margin-bottom: 0.5rem;
  }

  .notes-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  /* Testimonials */
  .testimonials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .testimonials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .testimonial-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background-color: var(--bg-secondary);
    padding: 2rem 1.75rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    position: relative;
