---
import Layout from '../layouts/Layout.astro';
import { getSiteSettings } from '../lib/data';

const settings = getSiteSettings();
---

<Layout
  title="Page Not Found"
  description="The page you were looking for could not be found."
  canonicalUrl="/404"
  noIndex={true}
  settings={settings}
>
  <div class="error-page-container">
    <span class="error-code" aria-hidden="true">404</span>
    <h1 class="error-title">Page Not Found</h1>
    <p class="error-desc">
      The photograph or page you were looking for may have moved or no longer exists.
    </p>

    <div class="error-actions">
      <a href="/" class="btn-editorial">Return Home</a>
      <a href="/portraits" class="btn-secondary">Explore Portraits</a>
      <a href="/contact" class="btn-secondary">Contact AY Gross</a>
    </div>
  </div>
</Layout>

<style>
  .error-page-container {
    max-width: 600px;
    padding: var(--spacing-3xl) 0 var(--spacing-2xl);
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    animation: pageEnter var(--transition-entrance) both;
  }

  @keyframes pageEnter {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .error-code {
    font-family: var(--font-brand);
    font-size: 6rem;
    line-height: 1;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
    opacity: 0.35;
    animation: floatCode 4s ease-in-out infinite;
    user-select: none;
  }

  @keyframes floatCode {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  .error-title {
    font-size: 2.25rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .error-desc {
    font-size: 1.05rem;
    color: var(--text-secondary);
    margin-bottom: 2.75rem;
    line-height: 1.6;
    max-width: 440px;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
</style>
