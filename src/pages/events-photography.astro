---
// Permanent redirect page for legacy URL /events-photography/ -> /#events
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Redirecting to Events | AY Gross Photography</title>
    <link rel="canonical" href="https://aygrossphotography.com/" />
    <meta http-equiv="refresh" content="0;url=/#events" />
    <meta name="robots" content="noindex, follow" />
    <script is:inline>
      window.location.replace('/#events');
    </script>
  </head>
  <body style="font-family: sans-serif; padding: 2rem; text-align: center;">
    <p>Redirecting to <a href="/#events">Events Photography</a>...</p>
  </body>
</html>
