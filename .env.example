# Public Sanity configuration (accessible to Astro build)
PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2024-01-01

# Optional read token for draft or preview content
# SANITY_API_READ_TOKEN=

# Private Sanity Write Token (used strictly by migration and mutation scripts - NEVER commit or expose to client)
SANITY_WRITE_TOKEN=

# Bunny.net Storage & Pull Zone Configuration (used by deployment script and GitHub Actions)
BUNNY_STORAGE_ZONE_NAME=aygross-storage
BUNNY_STORAGE_PASSWORD=your_storage_zone_password
BUNNY_STORAGE_REGION=de
BUNNY_PULL_ZONE_ID=your_pull_zone_id
BUNNY_API_KEY=your_bunny_account_api_key
